{
	admin off
}

https://steamcommunity.com {
	tls internal
	reverse_proxy https://steampowered.com:443 {
		header_up Host steamcommunity.com
		transport http {
			tls
			tls_server_name steampowered.com
		}
	}
	log {
		output file access.log
		format json
	}
}

https://www.steamcommunity.com {
	tls internal
	reverse_proxy https://steampowered.com:443 {
		header_up Host steamcommunity.com
		transport http {
			tls
			tls_server_name steampowered.com
		}
	}
	log {
		output file access.log
		format json
	}
}