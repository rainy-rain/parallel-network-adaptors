# 统一行尾，避免 Windows 上 clone 出的 shell 脚本带 CRLF 无法执行
* text=auto

*.sh    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.caddyfile text eol=lf
Caddyfile   text eol=lf
.gitignore  text eol=lf

*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

*.png   binary
*.ico   binary
*.exe   binary